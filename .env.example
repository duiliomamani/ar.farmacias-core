MONGODB_URI=mongodb://admin:password@localhost:27017/farmaya?authSource=admin
# Frontend origin(s), comma-separated.
FRONTEND_URL=http://localhost:3000
# Cloudflare Turnstile server key. If empty, CAPTCHA verification is disabled for local development.
TURNSTILE_SECRET_KEY=
# Hostnames returned by Turnstile Siteverify.
# Do not include https://, paths or ports.
# Local:
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Production example:
# TURNSTILE_HOSTNAMES=farmaya.ar,www.farmaya.ar
# Telegram destination for feedback notifications.
TELEGRAM_BOT_TOKEN=
FEEDBACK_CHAT_ID=
PORT=5001
